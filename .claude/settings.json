{
  "permissions": {
    "allow": [
      "Bash(uv sync*)",
      "Bash(uv run *)",
      "Bash(uvx ruff *)",
      "Bash(uvx ty *)",
      "Bash(ffprobe *)",
      "Bash(ffmpeg *)",
      "Bash(ollama list*)",
      "Bash(ollama ps*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(ollama pull *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$HOME/.local/bin:$PATH\" uvx ruff format --quiet ."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$HOME/.local/bin:$PATH\" uvx ruff check --quiet . 1>&2 || exit 2"
          }
        ]
      }
    ]
  }
}
